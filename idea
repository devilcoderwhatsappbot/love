<html lang="si">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>සුදු සර්පයාගේ පුරාවෘත්තය | සුදු මැණිකා ❤️🖤</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Sinhala:wght@300;400;500;600;700&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #111111;
            --bg-card: #141414;
            --bg-card-hover: #1a1a1a;
            --red-primary: #c41e3a;
            --red-light: #ff3355;
            --red-glow: rgba(196, 30, 58, 0.5);
            --red-soft: #ff6b7a;
            --red-dark: #8b1a2e;
            --red-deep: #4a0d1a;
            --red-rose: #e63956;
            --text-primary: #e0e0e0;
            --text-secondary: #888888;
            --text-white: #ffffff;
            --border-glow: rgba(196, 30, 58, 0.3);
            --shadow-red: rgba(196, 30, 58, 0.2);
            --black-pure: #000000;
            --black-rich: #0d0d0d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Noto Sans Sinhala', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.9;
            overflow-x: hidden;
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-primary);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--red-dark);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--red-primary);
        }

        /* Particles Background */
        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            background: radial-gradient(circle, var(--red-light) 0%, transparent 70%);
            border-radius: 50%;
            animation: floatParticle linear infinite;
            opacity: 0.2;
        }

        @keyframes floatParticle {
            0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
            10% { opacity: 0.3; }
            90% { opacity: 0.2; }
            100% { transform: translateY(-100px) rotate(720deg); opacity: 0; }
        }

        /* Hero Section */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 2rem;
            overflow: hidden;
            background: 
                radial-gradient(ellipse at 30% 50%, rgba(196, 30, 58, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 70% 50%, rgba(74, 13, 26, 0.3) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 0%, rgba(196, 30, 58, 0.1) 0%, transparent 70%),
                var(--bg-primary);
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                linear-gradient(180deg, var(--black-rich) 0%, transparent 20%, transparent 80%, var(--bg-primary) 100%);
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
        }

        .snake-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
            animation: pulse 3s ease-in-out infinite;
            filter: drop-shadow(0 0 30px var(--red-glow));
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .hero-title {
            font-family: 'Noto Sans Sinhala', sans-serif;
            font-size: clamp(2rem, 6vw, 3.5rem);
            font-weight: 700;
            background: linear-gradient(135deg, var(--text-white) 0%, var(--red-soft) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            text-shadow: none;
            animation: fadeInUp 1s ease-out;
        }

        .hero-subtitle-en {
            font-family: 'Cinzel', serif;
            font-size: clamp(0.9rem, 2.5vw, 1.2rem);
            color: var(--red-primary);
            letter-spacing: 0.2em;
            margin-bottom: 1.5rem;
            animation: fadeInUp 1s ease-out 0.2s both;
        }

        .hero-tagline {
            font-size: clamp(1rem, 2.5vw, 1.3rem);
            color: var(--text-secondary);
            font-style: italic;
            margin-bottom: 2rem;
            animation: fadeInUp 1s ease-out 0.4s both;
        }

        .hearts {
            font-size: 1.8rem;
            margin-bottom: 2rem;
            animation: fadeInUp 1s ease-out 0.6s both;
            filter: drop-shadow(0 0 15px var(--red-glow));
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Chapter Navigation */
        .chapter-nav {
            position: relative;
            z-index: 2;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.6rem;
            max-width: 700px;
            margin: 0 auto 2rem;
            animation: fadeInUp 1s ease-out 0.8s both;
        }

        .chapter-nav a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border: 1px solid var(--border-glow);
            border-radius: 50%;
            color: var(--red-primary);
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            background: rgba(196, 30, 58, 0.05);
        }

        .chapter-nav a:hover {
            background: var(--red-primary);
            color: var(--text-white);
            transform: scale(1.15);
            box-shadow: 0 0 25px var(--red-glow);
        }

        .scroll-indicator {
            position: absolute;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            animation: bounce 2s infinite;
        }

        .scroll-indicator span {
            display: block;
            width: 24px;
            height: 24px;
            border-right: 2px solid var(--red-primary);
            border-bottom: 2px solid var(--red-primary);
            transform: rotate(45deg);
            opacity: 0.6;
        }

        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(15px); }
        }

        /* Main Content */
        .main-content {
            position: relative;
            z-index: 1;
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 1.5rem 4rem;
        }

        /* Chapter Card */
        .chapter {
            margin-bottom: 4rem;
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .chapter.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .chapter-card {
            background: linear-gradient(145deg, var(--bg-card), var(--bg-secondary));
            border-radius: 20px;
            padding: 2.5rem;
            border: 1px solid rgba(196, 30, 58, 0.15);
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            transition: all 0.3s ease;
        }

        .chapter-card:hover {
            border-color: rgba(196, 30, 58, 0.3);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.6), 0 0 30px var(--shadow-red);
        }

        .chapter-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--red-primary), var(--red-soft), transparent);
        }

        .chapter-card::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(196, 30, 58, 0.03) 0%, transparent 70%);
            pointer-events: none;
        }

        .chapter-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(196, 30, 58, 0.2);
        }

        .chapter-number {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--red-primary), var(--red-dark));
            border-radius: 50%;
            color: var(--text-white);
            font-weight: 700;
            font-size: 1.2rem;
            flex-shrink: 0;
            box-shadow: 0 4px 15px var(--shadow-red);
        }

        .chapter-title {
            font-size: clamp(1.2rem, 3vw, 1.6rem);
            font-weight: 600;
            color: var(--text-white);
            line-height: 1.4;
        }

        /* Visualization Box */
        .visualize {
            background: linear-gradient(135deg, rgba(196, 30, 58, 0.08), rgba(74, 13, 26, 0.15));
            border-left: 4px solid var(--red-primary);
            border-radius: 0 12px 12px 0;
            padding: 1.5rem;
            margin: 1.5rem 0;
            font-size: 0.95rem;
            color: var(--text-secondary);
            position: relative;
        }

        .visualize::before {
            content: '👁️';
            position: absolute;
            top: -12px;
            left: -12px;
            background: var(--bg-card);
            padding: 4px;
            border-radius: 50%;
            font-size: 1rem;
        }

        .visualize-label {
            font-weight: 600;
            color: var(--red-primary);
            margin-bottom: 0.5rem;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* Section Titles */
        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--red-soft);
            margin: 1.5rem 0 1rem;
            padding-left: 0.8rem;
            border-left: 3px solid var(--red-primary);
        }

        /* Story Text */
        .story-text {
            font-size: 1rem;
            line-height: 2;
            color: var(--text-primary);
            margin-bottom: 1rem;
            text-align: justify;
        }

        .story-text::first-letter {
            font-size: 1.2em;
            color: var(--red-primary);
        }

        /* Dialog */
        .dialog {
            background: rgba(196, 30, 58, 0.05);
            border-radius: 12px;
            padding: 1rem 1.2rem;
            margin: 1rem 0;
            font-style: italic;
            color: var(--text-white);
            border-left: 3px solid var(--red-primary);
            position: relative;
        }

        .dialog::before {
            content: '"';
            font-size: 2rem;
            color: var(--red-primary);
            position: absolute;
            top: -5px;
            left: 8px;
            opacity: 0.5;
            font-family: 'Cinzel', serif;
        }

        .dialog p {
            padding-left: 1.5rem;
            margin: 0;
        }

        /* Footer */
        .footer {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 4rem 2rem;
            border-top: 1px solid rgba(196, 30, 58, 0.15);
            background: linear-gradient(180deg, var(--bg-primary), var(--black-rich));
        }

        .footer-hearts {
            font-size: 2rem;
            margin-bottom: 1.5rem;
            animation: pulse 2s infinite;
            filter: drop-shadow(0 0 10px var(--red-glow));
        }

        .footer-message {
            font-size: 1.2rem;
            color: var(--red-primary);
            margin-bottom: 0.5rem;
        }

        .footer-sub {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }

        .footer-credit {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(196, 30, 58, 0.1);
        }

        .footer-tagline {
            font-family: 'Cinzel', serif;
            font-size: 0.9rem;
            color: var(--red-dark);
            letter-spacing: 0.15em;
            margin-top: 1.5rem;
        }

        /* Back to Top */
        .back-to-top {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            width: 48px;
            height: 48px;
            background: var(--red-primary);
            color: var(--text-white);
            border: none;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 100;
            box-shadow: 0 4px 15px var(--shadow-red);
        }

        .back-to-top.visible {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 25px var(--red-glow);
            background: var(--red-light);
        }

        /* Sticky Chapter Nav */
        .sticky-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 0.8rem 1rem;
            z-index: 50;
            transform: translateY(-100%);
            transition: transform 0.3s ease;
            border-bottom: 1px solid rgba(196, 30, 58, 0.2);
        }

        .sticky-nav.visible {
            transform: translateY(0);
        }

        .sticky-nav-inner {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            flex-wrap: wrap;
        }

        .sticky-nav a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border: 1px solid rgba(196, 30, 58, 0.3);
            border-radius: 50%;
            color: var(--red-primary);
            text-decoration: none;
            font-size: 0.75rem;
            transition: all 0.2s ease;
        }

        .sticky-nav a:hover,
        .sticky-nav a.active {
            background: var(--red-primary);
            color: var(--text-white);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .chapter-card {
                padding: 1.5rem;
            }

            .chapter-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.8rem;
            }

            .chapter-number {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }

            .visualize {
                padding: 1.2rem;
            }

            .chapter-nav a {
                width: 36px;
                height: 36px;
                font-size: 0.8rem;
            }

            .main-content {
                padding: 1rem 1rem 3rem;
            }

            .sticky-nav-inner {
                gap: 0.3rem;
            }

            .sticky-nav a {
                width: 30px;
                height: 30px;
                font-size: 0.7rem;
            }
        }

        @media (max-width: 480px) {
            .hero-title {
                font-size: 1.6rem;
            }

            .hero-subtitle-en {
                font-size: 0.8rem;
            }

            .chapter-card {
                padding: 1.2rem;
                border-radius: 14px;
            }

            .story-text {
                font-size: 0.95rem;
                line-height: 1.8;
            }

            .chapter-nav {
                gap: 0.4rem;
            }

            .chapter-nav a {
                width: 32px;
                height: 32px;
                font-size: 0.7rem;
            }
        }

        /* Animations */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.6s ease;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Glow effects */
        .glow-text {
            text-shadow: 0 0 10px var(--red-glow);
        }

        /* Decorative divider */
        .divider {
            text-align: center;
            margin: 3rem 0;
            font-size: 1.5rem;
            color: var(--red-primary);
            opacity: 0.6;
        }

        .divider::before,
        .divider::after {
            content: '✦';
            margin: 0 1rem;
            font-size: 0.8rem;
            vertical-align: middle;
            color: var(--red-dark);
        }
    </style>
</head>
