    <!-- Hero Section -->
    <section class="hero" id="hero">
        <div class="hero-content">
            <div class="snake-icon">🐍</div>
            <h1 class="hero-title">සුදු සර්පයාගේ පුරාවෘත්තය</h1>
            <p class="hero-subtitle-en">Legend of the White Snake · Bai She Zhuan</p>
            <p class="hero-tagline">අවුරුදු දහසක ආදරය, විරහව, පොරොන්දුව සහ සදාකාලික යළි හමුවීම</p>
